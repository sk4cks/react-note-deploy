apiVersion: v1
kind: Secret
metadata:
  name: auth-server-mail
  namespace: note
type: Opaque
stringData:
  # cp auth-server-mail.secret.yaml.example auth-server-mail.secret.yaml 후 값 채우기
  # kubectl apply -f k8s/auth-server-mail.secret.yaml
  MAILBOX_PASSWORD_SECRET: "replace-me-mailbox-secret"
  MAILBOX_PASSWORD_SALT: "0123456789abcdef0123456789abcdef"
  MAILCOW_API_KEY: "replace-me-mailcow-api-key"
